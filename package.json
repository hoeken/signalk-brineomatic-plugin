{
  "name": "signalk-brineomatic-plugin",
  "version": "1.5.0",
  "description": "Open hardware watermaker controller.  Data, control, and remote access.",
  "main": "src/index.js",
  "files": [
    "src/",
    "public/",
    "docs/screenshots/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "icons": "node scripts/icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "eslint --fix . && prettier --write .",
    "format:check": "eslint . && prettier --check .",
    "prepare": "husky",
    "release": "git tag -d v$npm_package_version; git tag v$npm_package_version && git push && git push origin v$npm_package_version"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.mjs": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoeken/signalk-brineomatic-plugin.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-hardware"
  ],
  "signalk": {
    "displayName": "Brineomatic",
    "appIcon": "icons/icon-192.png",
    "screenshots": [
      "./docs/screenshots/proxy.png",
      "./docs/screenshots/config.png"
    ]
  },
  "author": "Zach Hoeken",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hoeken/signalk-brineomatic-plugin/issues"
  },
  "homepage": "https://github.com/hoeken/signalk-brineomatic-plugin#readme",
  "dependencies": {
    "http-proxy": "^1.18.1",
    "yarrboard-client": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "ws": "^8.18.0"
  }
}
